NODE_ENV=development
HOST=127.0.0.1
PORT=3001

GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_1=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL_2=gemini-3.1-flash-lite

GEMMA_ENABLED=true
ASK_VEYLORA_MODEL=gemma-4-31b-it
ASK_VEYLORA_FALLBACK_MODEL_1=gemini-3.5-flash-lite
ASK_VEYLORA_FALLBACK_MODEL_2=gemini-3.1-flash-lite

# Supply your Google Gemini API key here:
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_DAILY_REQUEST_LIMIT=10
GEMINI_DAILY_WINDOW_HOURS=24
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_MAX_CONCURRENCY=2

ASK_VEYLORA_DAILY_REQUEST_LIMIT=10
ASK_VEYLORA_DAILY_WINDOW_HOURS=24
ASK_VEYLORA_MAX_OUTPUT_TOKENS=1200
ASK_VEYLORA_REQUEST_TIMEOUT_MS=30000
ASK_VEYLORA_CHAT_HISTORY_TTL_DAYS=7

GEMINI_ALLOW_PAID_USAGE=false
